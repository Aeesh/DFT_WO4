
&CONTROL
calculation = 'scf'
prefix = 'ZnWO4'
verbosity = 'high'
restart_mode = 'from_scratch'
outdir = './tmp/ZnWO4/'
pseudo_dir = 'pseudo_dojo_pbesol/'
etot_conv_thr = 1e-6
forc_conv_thr = 1e-5
/

&SYSTEM
ibrav = 0
nat = 12
ntyp = 4
ecutwfc = 100
ecutrho = 400
nspin = 2
occupations = 'smearing'
smearing = 'mv'
degauss = 0.02
starting_magnetization(1) = 0.20
starting_magnetization(2) = -0.20 
starting_magnetization(3) = 0.00 
starting_magnetization(4) = 0.00
/

&ELECTRONS
electron_maxstep = 150
mixing_beta = 0.7
mixing_mode = 'local-TF'
conv_thr = 1.0e-8
diagonalization = 'david'
/

ATOMIC_SPECIES
Zn1 65.390 Zn.upf
Zn2 65.390 Zn.upf
W   183.84 W.upf
O  15.999 O.upf

