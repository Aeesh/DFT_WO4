
&CONTROL
calculation = 'scf'
prefix = 'CoWO4'
verbosity = 'high'
restart_mode = 'from_scratch'
outdir = './tmp/CoWO4'
pseudo_dir = 'pseudo_dojo_pbesol/'
etot_conv_thr = 1e-6
forc_conv_thr = 1e-5
/

&SYSTEM
ibrav = 0
nat = 12
ntyp = 3
ecutwfc = 120
ecutrho = 480
occupations = 'smearing'
smearing = 'mv'
degauss = 0.02
nspin = 2
starting_magnetization(1) = 0.20
starting_magnetization(2) = 0.00
starting_magnetization(3) = 0.00
/

&ELECTRONS
electron_maxstep = 150
mixing_beta = 0.7
mixing_mode = 'local-TF'
conv_thr = 1.0e-9
diagonalization = 'david'
/

