
&CONTROL
calculation = 'scf'
prefix = 'NiWO4'
verbosity = 'high'
disk_io = 'nowf'
disk_io = 'nowf'restart_mode = 'from_scratch'
outdir = './tmp/'
pseudo_dir = 'pseudos/'
etot_conv_thr = 1e-6
forc_conv_thr = 1e-5
/

&SYSTEM
ibrav = 0
nat = 12
ntyp = 4
ecutwfc = 100
ecutrho = 400
occupations = 'smearing'
smearing = 'mv'
degauss = 0.02
nspin = 2
starting_magnetization(1) = 0.2
starting_magnetization(2) = -0.2
starting_magnetization(3) = 0.0
starting_magnetization(4) = 0.0

/

&ELECTRONS
electron_maxstep = 150
mixing_beta = 0.7
mixing_mode = 'local-TF'
conv_thr = 1.0e-8
diagonalization = 'david'
/

ATOMIC_SPECIES
