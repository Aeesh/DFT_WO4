&control
    calculation = 'scf'
    prefix = 'silicon'
    pseudo_dir = './'
    outdir = './'
/
&system
    ibrav = 2,
    celldm(1) = 10.2,
    nat = 2,
    ntyp = 1,
    ecutwfc = 30.0,
    ecutrho = 240.0,
/
&electrons
    conv_thr = 1.0d-8
    mixing_beta = 0.7
/
ATOMIC_SPECIES
Si  28.0855  Si.pz-vbc.UPF
ATOMIC_POSITIONS crystal
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25
K_POINTS automatic
4 4 4 1 1 1
