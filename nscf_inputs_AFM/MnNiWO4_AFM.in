&CONTROL
calculation = 'nscf'
prefix = 'MnNiWO4_AFM'
verbosity = 'high'
disk_io = 'nowf'
restart_mode = 'from_scratch'
outdir = './tmp/MnNiWO4_AFM/'
pseudo_dir = 'pseudo_dojo_pbesol/'
etot_conv_thr = 1e-6
forc_conv_thr = 1e-5
/

&SYSTEM
ibrav = 0
nat = 12
ntyp = 4
ecutwfc = 120
ecutrho = 480
occupations = 'fixed'
nspin = 2
starting_magnetization(1) = 0.20   ! Mn - spin up
starting_magnetization(2) = -0.20  ! Ni - spin down (AFM)
starting_magnetization(3) = 0.00   ! W
starting_magnetization(4) = 0.00   ! O
nbnd = 80
/

&ELECTRONS
electron_maxstep = 150
mixing_beta = 0.7
mixing_mode = 'local-TF'
conv_thr = 1.0e-9
diagonalization = 'david'
/

ATOMIC_SPECIES
Mn  54.938045  Mn.upf
Ni  58.6934    Ni.upf
W   183.84     W.upf
O   15.9994    O.upf

ATOMIC_POSITIONS crystal
Mn               0.5000000000        0.6723630062        0.7500000000
Ni               0.5000000000        0.3360282070        0.2500000000
