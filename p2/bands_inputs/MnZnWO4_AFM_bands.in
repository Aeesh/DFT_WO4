&CONTROL
  calculation = 'bands'
  prefix = 'MnZnWO4_AFM'
  outdir = './tmp/MnZnWO4_AFM/'
  pseudo_dir = 'pseudo_dojo_pbesol/'
  verbosity = 'high'
/

&SYSTEM
  ibrav = 0
  nat = 12
  ntyp = 4
  ecutwfc = 120
  ecutrho = 480
  occupations = 'fixed'
  nspin = 2
  starting_magnetization(1) = 0.2   ! Mn
  starting_magnetization(2) = -0.2   ! Zn
  starting_magnetization(3) = 0.00   ! W
  starting_magnetization(4) = 0.00   ! O
  nbnd = 80
/

&ELECTRONS
  electron_maxstep = 150
  mixing_beta = 0.7
  conv_thr = 1.0e-9
  diagonalization = 'david'
/

