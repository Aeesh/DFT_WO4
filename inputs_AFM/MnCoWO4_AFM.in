&CONTROL
calculation = 'scf'
prefix = 'MnCoWO4_AFM'
verbosity = 'high'
restart_mode = 'from_scratch'
outdir = './tmp/MnCoWO4_AFM/'
pseudo_dir = '../../../pseudo_pbe/'
etot_conv_thr = 1e-6
forc_conv_thr = 1e-5
/

&SYSTEM
ibrav = 0
nat = 12
ntyp = 4
ecutwfc = 120
ecutrho = 480
occupations = 'smearing'
smearing = 'mv'
degauss = 0.02
nspin = 2
starting_magnetization(1) = 0.20   ! Mn - spin up
starting_magnetization(2) = -0.20  ! Co - spin down (AFM)
starting_magnetization(3) = 0.00   ! W
starting_magnetization(4) = 0.00   ! O
/

&ELECTRONS
electron_maxstep = 150
mixing_beta = 0.7
mixing_mode = 'local-TF'
conv_thr = 1.0e-9
diagonalization = 'david'
/

ATOMIC_SPECIES
Mn  54.938045  Mn.upf
Co  58.933195  Co.upf
W   183.84     W.upf
O   15.9994    O.upf

ATOMIC_POSITIONS crystal
